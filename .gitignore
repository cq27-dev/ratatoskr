/target
# Runtime state (logs, store, worktrees) is ignored; version-controlled agent scripts are not.
/.ratatoskr/*
!/.ratatoskr/rules/
!/.ratatoskr/workflow.ts
ratatoskr.toml
.env
# Agent-local settings; the shared skills/rules under .claude/ and .agents/ ARE tracked.
.claude/settings.local.json
# Dashboard build artifacts; `bun install && bun run build` in crates/ratatoskr-serve/web.
node_modules/
crates/ratatoskr-serve/web/dist/
