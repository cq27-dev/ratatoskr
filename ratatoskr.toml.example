# Example Ratatoskr configuration. Copy to `ratatoskr.toml` (or run `ratatoskr init`).

# Optional. Delete this whole section to run the harness without a code index — see
# `examples/without-rag-rat.toml` for what that costs and what still works.
[rag_rat]
# How to launch rag-rat's MCP server over stdio. `--json` selects JSON output (not the default
# TOON) so nodes that parse tool results directly get a stable shape.
command = ["npx", "-y", "@rag-rat/bin", "mcp", "--json"]
# working_dir = "/path/to/target/repo"

[store]
# Ratatoskr's own checkpoint database — a separate file from rag-rat's index.
path = ".ratatoskr/state.sqlite3"

[worktree]
# Root for per-run git worktrees. `run` leaves a converged run's worktree here for review;
# `ratatoskr clean` reclaims them (and their `ratatoskr/*` branches) when you're done.
#
# Keep this OUTSIDE the repository. Build tools find their project root by walking up, so a
# worktree nested in the checkout resolves to the outer project instead of itself — cargo, for
# one, then builds into the outer `target/`, which the sandbox mounts read-only.
root = "../.ratatoskr-worktrees"

# Per-node model routing. `ask` is the only route used in Phase 1; provider is one of
# "anthropic", "openai" or "moonshot", read from ANTHROPIC_API_KEY / OPENAI_API_KEY /
# MOONSHOT_API_KEY. Each also takes a base-URL override — ANTHROPIC_BASE_URL, OPENAI_BASE_URL,
# MOONSHOT_API_BASE — so a route can be pointed at a local gateway, or at whichever of a
# provider's platforms issued the key. The rest are illustrative, forward-looking node routes
# (Phase 2+).
#
# "openai" runs on the Responses API, not chat completions: a reasoning model's thinking then
# carries across the agent's tool-calling turns instead of being re-derived every turn.
#
# Nothing stops a run from spanning providers, and there is one place it is worth doing on
# purpose: review. A verifier on a different family from the model that wrote the change is a
# second opinion rather than a second look.
[models.ask]
provider = "anthropic"
model = "claude-sonnet-4-6"

[models.context]
provider = "moonshot"
model = "kimi-k2.5"
# `context_window` is how many tokens the model holds. It decides when a node's history is
# summarised rather than carried: the budget is two thirds of it, leaving room for the summary
# call, the tool declarations and the turn that tripped it — a budget at the window's edge
# produces a context-length error instead of a compaction.
#
#   [models.analyst]
#   context_window = 1048576
#
# Stated rather than looked up, for the same reason as `max_tokens`: a table of model names
# compiled into the binary cannot know a model released after it. Unset, every node keeps a
# conservative 120k of history, which is safe on anything but summarises early on a large model.
# Ask the endpoint rather than guessing — most report it (`/v1/models` carries `context_window` or
# `context_length`), and a window declared larger than the model's turns a compaction into a
# context-length error.
#
# Declaring one *smaller* is fine and sometimes the only sensible reading. Some providers price a
# request above a threshold well below the model's window: OpenAI's Codex charges 2x input and
# 1.5x output on the WHOLE request once it passes 272,000 input tokens, against a window of over a
# million. Sized against the ceiling, a node would drift across that line and double its own bill
# without anything looking wrong. Size against the cliff.
#
# A route may also set `temperature`, and `params` for anything the provider takes that this
# config has no word for. `params` is merged into the request verbatim — which means the spelling
# is the provider's, not this file's, and a field one provider knows is one another silently
# ignores. Copying a `params` block between routes of different providers is the way to get a
# node that quietly reasons at whatever the endpoint defaults to.
#
# Thinking is the one worth knowing about: some endpoints turn it on as soon as a request carries
# tools, and every node here carries tools. A node that thinks before each of forty file reads
# spends most of its wall-clock deciding which file to open next, so it is worth turning down for
# the nodes that explore and leaving up for the ones that judge. Each provider spells that
# differently:
#
#   # anthropic
#   [models.context.params.thinking]
#   type = "disabled"                 # or type = "enabled" with budget_tokens = 4000
#
#   # openai, on the Responses API
#   [models.verifier.params.reasoning]
#   effort = "medium"
#
#   # moonshot
#   [models.context.params.thinking]
#   type = "enabled"
#   effort = "low"                    # Kimi For Coding's K3: low | high | max, default high
#
# Not every model can be told to stop thinking. Kimi's coding models report
# `supports_thinking_type: "only"`, so there the knob is how much, never whether.
#
# Thinking tokens are billed as output and count against `max_tokens`; raise it alongside any
# budget you set.
#
# `session` decides whether a node continues across attempts within a run. "fresh" (the default)
# starts a new one each time. "reuse" keeps an endpoint session for the node, so it needs
# `[endpoint] session_header` set for anything to key off. "compacted" instead carries a local,
# compacted hand-off between attempts and works with every provider without endpoint session support.
#
#   [models.implementer]
#   session = "reuse"
#   # Or, for an endpoint without session support:
#   # session = "compacted"
#
# `[endpoint]` — its headers and a `reuse` session id — rides on the anthropic client only. On an
# openai or moonshot route `session = "reuse"` is accepted and does nothing. `session =
# "compacted"` is local and works on every provider.
#
# On thinking levels: leaving it unset is not the cheap option. Measured on a reasoning-heavy
# prompt with tools present, against an Anthropic route through a gateway that takes
# `output_config`, the unset default ran 26-39s and was the least predictable setting available;
# `effort` at low, medium and high all landed between 23s and 30s with reasoning still on, and
# disabling thinking entirely at 24-25s. A node that should think is better told how much:
#
#   [models.verifier.params.output_config]
#   effort = "medium"
#
# Safe to send alongside a node's output schema: in `OutputMode::Tool`, which every node uses, the
# schema becomes a `final_result` tool and the provider layer sets no `output_config` of its own,
# so this is the only one in the request.

[models.analyst]
provider = "anthropic"
model = "claude-sonnet-4-6"

[models.implementer]
provider = "anthropic"
model = "claude-opus-4-8"

[models.bookkeeper]
provider = "moonshot"
model = "kimi-k2.5"

# Optional reusable agent profiles. They separate reusable model/prompt/authority defaults from
# stable stage identities and checkpoint names. A profile model overrides `[models.<stage>]`; omit
# it to retain the existing stage-keyed route. See `examples/agent-profiles.toml` for a complete
# configuration, including a dedicated profile for a declared workflow stage.
#
# [agents.explore]
# capabilities = ["read"]
# base_prompt = "Inspect the repository before drawing conclusions."
#
# [agents.reason]
# capabilities = ["read"]
#
# [agents.build]
# capabilities = ["write"]
#
# [agents.publish]
# capabilities = ["publish"]

# Optional: with a [models.redteam] route set, red-team adds one LLM pass classifying each baseline
# failure as flaky vs real (an additive field; the deterministic pass/fail is untouched). Omit to
# skip classification entirely.
# [models.redteam]
# provider = "moonshot"
# model = "kimi-k2.5"

# Optional: with a [models.verifier] route set, converge reviews the diff once the tests are clean
# and sends the change back on real findings. It answers what the tests cannot — a requirement
# missed, a test weakened rather than satisfied, an invariant a repo memory records. Findings it
# judges to be faults in the PLAN route to the analyst to re-plan; the rest go to the implementer.
# Omit to skip review entirely and converge on the test result alone.
# [models.verifier]
# provider = "anthropic"
# model = "claude-sonnet-5"

# Optional: with a [models.overseer] route set, a repo that defines several workflows has one
# chosen for it per task, from each workflow's declared purpose and `whenToUse` cases. The choice
# and its reasoning land on a checkpoint. Consulted only when there is a real choice — never when
# `--workflow` named one, and never when the repo defines fewer than two. Omit and a repo with
# several workflows is asked to name one rather than guessed at.
# [models.overseer]
# provider = "anthropic"
# model = "claude-sonnet-5"

# Optional: with a [models.characterizer] route set, a cheap model reads each acceptance step's
# raw output and names the individual checks that passed and failed — so converge compares at test
# granularity for any toolchain, with no parser to teach. Omit and a run still converges, comparing
# whole steps by exit code: coarser, never wrong. The exit code is authoritative either way.
# [models.characterizer]
# provider = "moonshot"
# model = "kimi-k2.5"
#
# It transcribes; it never judges. Pin thinking off — an endpoint that turns reasoning on unasked
# buys a reasoning pass in front of every transcription, and this node runs on every acceptance
# run, twice per converge iteration.
#
#   [models.characterizer.params.thinking]
#   type = "disabled"

# The implementer edits an isolated worktree and runs its checks in the sandbox. It needs a
# [models.implementer] route like any other node.
[implementer]
max_iterations = 3      # converge re-runs the implementer at most this many times
max_turns = 100          # model/tool-call turns available to each implementer attempt
# The least severe review finding that sends a change back to be fixed: "P1" (must-fix only),
# "P2" (the default, also should-fix), or "P3" (nits too). Findings below it are still recorded.
# P3 is deliberately not the default: the verifier shares max_iterations with the test-fixing
# loop, so re-driving on style can spend the budget before a real failure surfaces.
verify_threshold = "P2"
# The analyst decides whether carrying out its plan means changing code. When it says no —
# research, a review, an architecture question — the fork is skipped and the run finishes
# `no_code_change` instead of paying for a baseline test run and an implementer session to produce
# an empty diff. Set this to override that judgement; it only ever adds the fork back.
always_fork = false

# Phase 3: red-team and implementer run the repo's tests in a sandbox.
[sandbox]
backend = "landlock"                        # "landlock" (bwrap+Landlock, default), "container",
                                            # or "microsandbox" (needs KVM AND a build with
                                            # `--features microsandbox`)
image = "docker.io/library/rust:1-slim"     # OCI image the container or microsandbox boots
# Resource limits for each acceptance step and implementer Bash call. Container and microsandbox
# enforce both; landlock logs once that bwrap cannot enforce them.
cpus = 2
memory_mib = 2048
# The DEFAULT acceptance: one step, used when the analyst proposes none. The analyst decides what
# "done" means per task and may replace this with an ordered pipeline — "build the wasm, then drive
# it in a browser" is two steps, not one.
test_command = ["cargo", "test"]
# Programs an acceptance step may reach the network for, by name. Acceptance runs offline: a test
# that reaches the network fails for reasons the repository does not control. But a repository whose
# dependencies are not vendored cannot check anything until they are fetched — a fresh worktree has
# no `node_modules`, so the type-checker fails on the framework rather than on the change.
#
# An entry matches the start of a step's command, so it can name a program or a program and its
# subcommand. That distinction matters: in most ecosystems the installer and the test runner are
# the same program, so a bare "npm" would put the checks online too.
#
#   network_allow = ["npm install", "npm ci"]
#
# Not by host. The sandbox's network namespace is all-or-nothing for one invocation, so a step that
# can reach a registry can reach anything; restricting by hostname needs something that can see the
# request, which a namespace cannot.
network_allow = []

# Fetch this project's dependencies once, outside any run, with `ratatoskr prepare`. Runs then
# mount what it left, read-only and with no network — so an acceptance check never resolves a
# dependency, and the baseline and post-change runs cannot disagree about what a registry served at
# two different moments. Requires `backend = "container"`: mounting one host path at a different
# guest path is what puts `node_modules` where a resolver looks, and the bwrap backend can only
# mount in place.
#
# The project is mounted READ-ONLY while these run, so use the frozen form of each command — a
# prepare that rewrites its lockfile would make every later run depend on the day it ran.
#
#   prepare = [["npm", "ci"], ["cargo", "fetch", "--locked"]]
#
# Each cache names where it is stored (`from`, under `.ratatoskr/deps/`) and where a run sees it
# (`at` — absolute taken as-is, for an image-owned path like a cargo registry; relative resolved
# against the worktree, which is what `node_modules` needs).
#
#   [[sandbox.cache]]
#   from = "node_modules"
#   at   = "crates/ratatoskr-serve/web/node_modules"
#
#   [[sandbox.cache]]
#   from = "cargo-registry"
#   at   = "/usr/local/cargo/registry"
prepare = []

# Ignore whatever the analyst proposes and always run test_command. For a repo that does not want
# a model deciding what proves its code works.
pin_acceptance = false

# Where a run's output goes when it finishes. Off by default, and deliberately a switch rather than
# something inferred from having a [models.publisher] route: the publisher is the only node that
# acts outside this machine, and a run that opens a pull request nobody expected is worse than one
# that publishes nothing. With it on, the publisher decides for itself whether the run produced a
# pull request, a comment on the issue it was given, both, or neither — and writes through `gh`,
# which must be installed and authenticated.
[publish]
enabled = false
# The label every pull request a run opens carries, so a reviewer can tell what wrote the change in
# front of them. Set it to another word to use that instead, or to "" to add none — a repository
# that already labels automation its own way should not be given a second scheme.
label = "ratatoskr"
# How a run's commit subject is built, over `{type}`, `{scope}` and `{summary}` — the three things
# the implementer reports about its own change. Conventional-commit by default, because a run whose
# commits do not match the surrounding history is a run whose commits get rewritten by hand. Set it
# to what your log already looks like: "{summary}" for no convention, "[{scope}] {summary}", …
# `({scope})` drops out whole when a change belongs to no particular part, so the default gives
# `fix: …` rather than `fix(): …`. Subjects longer than 72 characters are cut at a word boundary.
commit_subject = "{type}({scope}): {summary}"
# Who a run's commits are authored by. Set per commit rather than read from the environment: a
# commit claiming whoever happens to have `user.name` set on this machine is a lie in the history.
# Give runs an address of their own — a forge attributes a commit to whichever account owns the
# address, so a person's address credits that person with work they did not do. The default
# resolves nowhere on purpose.
committer_name = "ratatoskr"
committer_email = "ratatoskr@localhost"



# Optional: with a [models.publisher] route set and [publish] enabled, a finished run delivers what
# it made to the tracker, in parallel with the bookkeeper recording what it learned.
# [models.publisher]
# provider = "anthropic"
# model = "claude-sonnet-5"

# Agent plugins, in the format coding CLIs already use. `.ratatoskr/plugins/` is always searched;
# these paths add plugins installed elsewhere, and may name a plugin or a directory of them.
# A plugin's SessionStart hook runs once per run and its output is prefixed to each node's preamble.
#
# A coding CLI's cache keeps every version it has installed, so a path naming the plugin rather
# than one version is the right thing to write — the installed one is the one that loads:
#   paths = ["~/.claude/plugins/cache/rag-rat/rag-rat"]
# How to address the model endpoint, beyond its URL and key. Both optional and empty by default.
#
# A local endpoint in front of a provider is not always a proxy. One that reconstructs the request
# — replaying it as a prompt into its own agent session — decides for itself what is cached and
# what is discarded, and decides it from what the client looks like. A client it does not
# recognise gets whatever default its author picked for someone else, which for a tool-calling
# run means the conversation is rebuilt on every turn instead of read back from cache.
#
# `headers` is what identifies this client. `session_header` names the header carrying a
# per-conversation id: one is generated per node attempt and held for every turn of that attempt,
# so an endpoint that tracks sessions can continue the conversation rather than start it again.
#
#   [endpoint]
#   headers = { "x-meridian-agent" = "passthrough" }
#   session_header = "x-litellm-session-id"

[plugins]
paths = []
# Skills no node should be offered, by name. A plugin is installed whole, and some of what it
# ships is written for a person at a keyboard — a setup procedure that expects to ask questions
# and be answered is the clear case. Such a skill costs every node that binds the plugin the space
# its description takes, on every call, to offer something no node can carry out. By name rather
# than by plugin, because the rest of the plugin is usually worth having.
# skills_deny = ["init-rag-rat"]

# What a plugin's hooks may spend. The defaults are the plugin format's own, so a plugin behaves
# here the way its author tested it in a coding CLI. They are generous because that host has a
# person watching; a run here is unattended, so lower them if plugins are a latency budget.
[plugins.hooks]
timeout_secs = 600        # a hook that declares no `timeout` of its own
max_timeout_secs = 600    # ceiling on one that does
output_budget = 10000     # characters one event's hooks may contribute
context_budget = 10000    # characters of plugin context a node carries into its preamble
# Total seconds a run will spend in hooks that run around tool calls; 0 means no limit. Not part
# of the format — it has no equivalent, because a person can interrupt an interactive session.
# These hooks fire on every tool call a node makes, so this is the only bound on the whole run.
tool_time_budget_secs = 0
